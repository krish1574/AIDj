# Copy the relevant block into apps/api/.env and apps/mobile/.env.
# Never commit real values. Convex prints both URLs when `npx convex dev` runs.

# --- apps/api/.env ---
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- apps/mobile/.env ---
# EXPO_PUBLIC_ variables are embedded in the JS bundle and are readable by
# anyone with the APK. Never put a secret here.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Optional in development: the app derives the dev machine's LAN address from
# the Metro host when this is unset. A physical device cannot reach localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# --- Convex deployment environment (set with `npx convex env set`) ---
# AUTH_RESEND_KEY=re_...
# AIDJ_ALLOW_ANONYMOUS_AUTH=true   # development only - lets anyone sign in
